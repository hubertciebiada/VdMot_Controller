// STM32F401CC BlackPill for the tests of the Rust images (docs/rust/GLUE-DESIGN-STM.md §5.7):
// Renode's STM32F4 with the F401 memory sizes, the clocks of the Rust firmware and the board
// around the chip (vdm_board.repl).
using "platforms/cpus/stm32f4.repl"
using "./vdm_board.repl"

sram:
    size: 0x10000

flash:
    size: 0x40000

// SysTick runs from the boot clock in the boot stage: HSE 25 MHz (the HSE test sets 16 MHz)
nvic:
    systickFrequency: 25000000

// the timers on the timer clocks of the application (84 MHz on APB1 x2 and APB2): TIM1 and TIM2
// run the valve machine, TIM5 is the embassy time driver
timer1:
    frequency: 84000000

timer2:
    frequency: 84000000

timer5:
    frequency: 84000000

// the cycle counter of the 1-Wire slots at the application's SYSCLK
dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 84000000

// SYSCFG has no model: plain memory, so MEMRMP reads back
syscfg: Memory.MappedMemory @ sysbus 0x40013800
    size: 0x400

// the platform applies an SVD file from the network at start; not needed here
sysbus:
    init:
        Tag <0xE0042000, 0xE0042003> "DBGMCU_IDCODE" 0x10006423
