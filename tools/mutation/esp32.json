{
  "repo": "../..",
  "root": "software_esp32_revamped",
  "shared": ["tools/native/testkit"],
  "files": "lib/core/src/*.cpp",
  "scope": "lib/core/src/*.cpp",
  "excluded": {},
  "equivalents_dir": "tools/mutation/equivalents/esp32",
  "setup": "cmake -S test/native -B {build} -G Ninja -DCMAKE_BUILD_TYPE=Mutation -DCMAKE_CXX_COMPILER_LAUNCHER=ccache",
  "build": "cmake --build {build} --target core_{stem}",
  "test_file": "{build}/core_{stem} -aa=1 -tse=slow,fuzz",
  "test": "{build}/core_{stem} -aa=1 -ts=slow,fuzz",
  "timeout_min": 5,
  "timeout_factor": 10,
  "timeout_build": 900,
  "threshold": 95,
  "file_threshold": 95,
  "deadcode": true,
  "stillborn": "exclude"
}
